    <report>maven-file-activity-plugin</report>
    <report>maven-developer-activity-plugin</report>
    <report>maven-javadoc-plugin</report>
    <report>maven-jxr-plugin</report>
    <report>maven-junit-report-plugin</report>
    <report>maven-tasklist-plugin</report>
    <report>maven-pmd-plugin</report>
    <report>maven-simian-plugin</report>
    <!-- <report>maven-faq-plugin</report> -->
  </reports>
  <profiles>
    <profile>
      <id>JDK9</id>
      <activation>
        <jdk>[9</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <release>6</release>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>JDK11</id>
      <activation>
        <jdk>[11</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <release>8</release>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Jakarta EE 9+ variant, published as the "jakarta" classifier.

      The sources stay on javax.servlet. The jakarta JAR is assembled from
      the compiled classes in three steps that start from empty directories
      on every build:

        process-classes       src/jakarta (classes that must differ in the
                              jakarta JAR) is compiled against Jakarta
                              Servlet 5.0 into target/jakarta-overlay-classes.
        process-test-classes  target/classes, the overlay classes and the
                              unpacked commons-fileupload 1.x classes are
                              copied into target/jakarta-classes, the test
                              classes into target/jakarta-test-classes, and
                              Eclipse Transformer rewrites both in place.
        test                  The transformed test suite runs again against
                              Jakarta Servlet 6.0 / JSP 3.1.

      The JAR is packaged in "package", and src/it/jakarta-tomcat deploys it
      to Tomcat 10.1 in "integration-test" (maven-invoker-plugin).

      commons-fileupload is bundled under its original package name (not
      relocated) because CommonsMultipartRequestHandler exposes FileItem in
      protected methods.

      Eclipse Transformer 1.0.0 requires JDK 17, so this profile is only
      active on JDK 17+. Classes are compiled with release=8 there.
    -->
    <profile>
      <id>jakarta</id>
      <activation>
        <jdk>[17,)</jdk>
      </activation>
      <properties>
        <maven.test.skip>false</maven.test.skip>
        <jakarta.overlay-classes>${project.build.directory}/jakarta-overlay-classes</jakarta.overlay-classes>
        <jakarta.classes>${project.build.directory}/jakarta-classes</jakarta.classes>
        <jakarta.test-classes>${project.build.directory}/jakarta-test-classes</jakarta.test-classes>
        <jakarta.test-api>${project.build.directory}/jakarta-test-api</jakarta.test-api>
      </properties>
      <dependencies>
        <!-- Compile the overlay against the oldest supported API. -->
        <dependency>
          <groupId>jakarta.servlet</groupId>
          <artifactId>jakarta.servlet-api</artifactId>
          <version>5.0.0</version>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>jakarta-clean</id>
                <phase>process-classes</phase>
                <goals><goal>clean</goal></goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset><directory>${jakarta.overlay-classes}</directory></fileset>
                    <fileset><directory>${jakarta.classes}</directory></fileset>
                    <fileset><directory>${jakarta.test-classes}</directory></fileset>
                    <fileset><directory>${jakarta.test-api}</directory></fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.13.0</version>
            <executions>
              <execution>
                <id>jakarta-overlay</id>
                <phase>process-classes</phase>
                <goals><goal>compile</goal></goals>
                <configuration>
                  <compileSourceRoots>
                    <compileSourceRoot>${project.basedir}/src/jakarta</compileSourceRoot>
                  </compileSourceRoots>
                  <outputDirectory>${jakarta.overlay-classes}</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>jakarta-unpack-fileupload</id>
                <phase>process-test-classes</phase>
                <goals><goal>unpack</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>commons-fileupload</groupId>
                      <artifactId>commons-fileupload</artifactId>
                      <overWrite>true</overWrite>
                      <outputDirectory>${jakarta.classes}</outputDirectory>
                      <excludes>META-INF/MANIFEST.MF,META-INF/maven/**,META-INF/versions/**,org/apache/commons/fileupload/portlet/**</excludes>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
              <execution>
                <!--
                  Added after the transformation so that scanners can identify
                  the bundled version from unmodified Maven metadata.
                -->
                <id>jakarta-unpack-fileupload-metadata</id>
                <phase>prepare-package</phase>
                <goals><goal>unpack</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>commons-fileupload</groupId>
                      <artifactId>commons-fileupload</artifactId>
                      <overWrite>true</overWrite>
                      <outputDirectory>${jakarta.classes}</outputDirectory>
                      <includes>META-INF/maven/**</includes>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
              <execution>
                <id>jakarta-copy-test-api</id>
                <phase>process-test-classes</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <skip>${maven.test.skip}</skip>
                  <stripVersion>true</stripVersion>
                  <artifactItems>
                    <!-- Oldest supported (Jakarta EE 9), tested runtime (Jakarta EE 10), newest (Jakarta EE 11). -->
                    <artifactItem>
                      <groupId>jakarta.servlet</groupId>
                      <artifactId>jakarta.servlet-api</artifactId>
                      <version>5.0.0</version>
                      <outputDirectory>${jakarta.test-api}/5.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.servlet.jsp</groupId>
                      <artifactId>jakarta.servlet.jsp-api</artifactId>
                      <version>3.0.0</version>
                      <outputDirectory>${jakarta.test-api}/5.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.el</groupId>
                      <artifactId>jakarta.el-api</artifactId>
                      <version>4.0.0</version>
                      <outputDirectory>${jakarta.test-api}/5.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.servlet</groupId>
                      <artifactId>jakarta.servlet-api</artifactId>
                      <version>6.0.0</version>
                      <outputDirectory>${jakarta.test-api}/6.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.servlet.jsp</groupId>
                      <artifactId>jakarta.servlet.jsp-api</artifactId>
                      <version>3.1.1</version>
                      <outputDirectory>${jakarta.test-api}/6.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.el</groupId>
                      <artifactId>jakarta.el-api</artifactId>
                      <version>5.0.1</version>
                      <outputDirectory>${jakarta.test-api}/6.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.servlet</groupId>
                      <artifactId>jakarta.servlet-api</artifactId>
                      <version>6.1.0</version>
                      <outputDirectory>${jakarta.test-api}/6.1</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.servlet.jsp</groupId>
                      <artifactId>jakarta.servlet.jsp-api</artifactId>
                      <version>4.0.0</version>
                      <outputDirectory>${jakarta.test-api}/6.1</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.el</groupId>
                      <artifactId>jakarta.el-api</artifactId>
                      <version>6.0.1</version>
                      <outputDirectory>${jakarta.test-api}/6.1</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>jakarta-copy-classes</id>
                <phase>process-test-classes</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${jakarta.classes}</outputDirectory>
                  <resources>
                    <resource><directory>${project.build.outputDirectory}</directory></resource>
                  </resources>
                </configuration>
              </execution>
              <execution>
                <id>jakarta-copy-overlay-classes</id>
                <phase>process-test-classes</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <overwrite>true</overwrite>
                  <outputDirectory>${jakarta.classes}</outputDirectory>
                  <resources>
                    <resource><directory>${jakarta.overlay-classes}</directory></resource>
                  </resources>
                </configuration>
              </execution>
              <execution>
                <!-- A missing directory (maven.test.skip) is a no-op. -->
                <id>jakarta-copy-test-classes</id>
                <phase>process-test-classes</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${jakarta.test-classes}</outputDirectory>
                  <resources>
                    <resource><directory>${project.build.testOutputDirectory}</directory></resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.eclipse.transformer</groupId>
            <artifactId>transformer-maven-plugin</artifactId>
            <version>1.0.0</version>
            <configuration>
              <rules>
                <jakartaDefaults>true</jakartaDefaults>
              </rules>
            </configuration>
            <executions>
              <execution>
                <id>jakarta-transform-classes</id>
                <phase>process-test-classes</phase>
                <goals><goal>transform</goal></goals>
                <configuration>
                  <transformDirectory>${jakarta.classes}</transformDirectory>
                </configuration>
              </execution>
              <execution>
                <id>jakarta-transform-test-classes</id>
                <phase>process-test-classes</phase>
                <goals><goal>transform</goal></goals>
                <configuration>
                  <skip>${maven.test.skip}</skip>
                  <transformDirectory>${jakarta.test-classes}</transformDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>jakarta-test</id>
                <phase>test</phase>
                <goals><goal>test</goal></goals>
                <configuration>
                  <classesDirectory>${jakarta.classes}</classesDirectory>
                  <testClassesDirectory>${jakarta.test-classes}</testClassesDirectory>
                  <reportsDirectory>${project.build.directory}/surefire-reports-jakarta</reportsDirectory>
                  <classpathDependencyExcludes>
                    <classpathDependencyExclude>javax.servlet:servlet-api</classpathDependencyExclude>
                    <classpathDependencyExclude>jakarta.servlet:jakarta.servlet-api</classpathDependencyExclude>
