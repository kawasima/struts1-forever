  <profiles>
    <profile>
      <id>JDK9</id>
      <activation>
        <jdk>[9</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <release>6</release>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>JDK11</id>
      <activation>
        <jdk>[11</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <release>8</release>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Servlet 3.0+ and Jakarta EE 9+ variants, published as the "servlet3"
      and "jakarta" classifiers.

      The sources stay on javax.servlet. Both JARs are assembled from the
      compiled classes in three steps that start from empty directories on
      every build:

        process-classes       src/servlet3 (classes that replace their
                              Servlet 2.2 counterpart) is compiled against
                              Servlet 3.0 into target/servlet3-overlay-classes.
                              Ant's javac is used so that Servlet 3.0 comes
                              before Servlet 2.2 on the class path.
        process-test-classes  target/classes and the overlay classes are
                              copied into target/servlet3-classes. They are
                              also copied, with the unpacked commons-fileupload
                              1.x classes, into target/jakarta-classes, the
                              test classes into target/jakarta-test-classes,
                              and Eclipse Transformer rewrites both in place.
        test                  The test suite runs again against the servlet3
                              classes on Servlet 4.0 / JSP 2.3, and against
                              the transformed classes on Jakarta Servlet 6.0 /
                              JSP 3.1.

      The JARs are packaged in "package". In "integration-test"
      (maven-invoker-plugin), src/it/servlet3-tomcat deploys the servlet3 JAR
      to Tomcat 9.0 and src/it/jakarta-tomcat the jakarta JAR to Tomcat 10.1.

      commons-fileupload is bundled under its original package name (not
      relocated) because CommonsMultipartRequestHandler exposes FileItem in
      protected methods.

      Eclipse Transformer 1.0.0 requires JDK 17, so this profile is only
      active on JDK 17+. Classes are compiled with release=8 there.
    -->
    <profile>
      <id>jakarta</id>
      <activation>
        <jdk>[17,)</jdk>
      </activation>
      <properties>
        <maven.test.skip>false</maven.test.skip>
        <servlet3.overlay-classes>${project.build.directory}/servlet3-overlay-classes</servlet3.overlay-classes>
        <servlet3.classes>${project.build.directory}/servlet3-classes</servlet3.classes>
        <servlet3.test-api>${project.build.directory}/servlet3-test-api</servlet3.test-api>
        <jakarta.classes>${project.build.directory}/jakarta-classes</jakarta.classes>
        <jakarta.test-classes>${project.build.directory}/jakarta-test-classes</jakarta.test-classes>
        <jakarta.test-api>${project.build.directory}/jakarta-test-api</jakarta.test-api>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <version>3.4.1</version>
            <executions>
              <execution>
                <id>jakarta-clean</id>
                <phase>process-classes</phase>
                <goals><goal>clean</goal></goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset><directory>${servlet3.overlay-classes}</directory></fileset>
                    <fileset><directory>${servlet3.classes}</directory></fileset>
                    <fileset><directory>${servlet3.test-api}</directory></fileset>
                    <fileset><directory>${jakarta.classes}</directory></fileset>
                    <fileset><directory>${jakarta.test-classes}</directory></fileset>
                    <fileset><directory>${jakarta.test-api}</directory></fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <dependencies>
              <!-- The API the overlay is compiled against, through maven.plugin.classpath. -->
              <dependency>
                <groupId>javax.servlet</groupId>
                <artifactId>javax.servlet-api</artifactId>
                <version>3.0.1</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>servlet3-overlay</id>
                <phase>process-classes</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <mkdir dir="${servlet3.overlay-classes}"/>
                    <javac srcdir="${project.basedir}/src/servlet3"
                           destdir="${servlet3.overlay-classes}"
                           release="8" debug="true" includeantruntime="false">
                      <classpath>
                        <path refid="maven.plugin.classpath"/>
                        <path refid="maven.compile.classpath"/>
                      </classpath>
                    </javac>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <!-- Oldest supported (Tomcat 7), Tomcat 8.5, and newest (Tomcat 9). -->
                <id>servlet3-copy-test-api</id>
                <phase>process-test-classes</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <skip>${maven.test.skip}</skip>
                  <stripVersion>true</stripVersion>
                  <artifactItems>
                    <artifactItem>
                      <groupId>javax.servlet</groupId>
                      <artifactId>javax.servlet-api</artifactId>
                      <version>3.0.1</version>
                      <outputDirectory>${servlet3.test-api}/3.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>javax.servlet.jsp</groupId>
                      <artifactId>javax.servlet.jsp-api</artifactId>
                      <version>2.2.1</version>
                      <outputDirectory>${servlet3.test-api}/3.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>javax.el</groupId>
                      <artifactId>el-api</artifactId>
                      <version>2.2</version>
                      <outputDirectory>${servlet3.test-api}/3.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>javax.servlet</groupId>
                      <artifactId>javax.servlet-api</artifactId>
                      <version>3.1.0</version>
                      <outputDirectory>${servlet3.test-api}/3.1</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>javax.servlet.jsp</groupId>
                      <artifactId>javax.servlet.jsp-api</artifactId>
                      <version>2.3.1</version>
                      <outputDirectory>${servlet3.test-api}/3.1</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>javax.el</groupId>
                      <artifactId>javax.el-api</artifactId>
                      <version>3.0.0</version>
                      <outputDirectory>${servlet3.test-api}/3.1</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>javax.servlet</groupId>
                      <artifactId>javax.servlet-api</artifactId>
                      <version>4.0.1</version>
                      <outputDirectory>${servlet3.test-api}/4.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>javax.servlet.jsp</groupId>
                      <artifactId>javax.servlet.jsp-api</artifactId>
                      <version>2.3.3</version>
                      <outputDirectory>${servlet3.test-api}/4.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>javax.el</groupId>
                      <artifactId>javax.el-api</artifactId>
                      <version>3.0.0</version>
                      <outputDirectory>${servlet3.test-api}/4.0</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
              <execution>
                <id>jakarta-unpack-fileupload</id>
                <phase>process-test-classes</phase>
                <goals><goal>unpack</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>commons-fileupload</groupId>
                      <artifactId>commons-fileupload</artifactId>
                      <overWrite>true</overWrite>
                      <outputDirectory>${jakarta.classes}</outputDirectory>
                      <excludes>META-INF/MANIFEST.MF,META-INF/maven/**,META-INF/versions/**,org/apache/commons/fileupload/portlet/**</excludes>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
              <execution>
                <!--
                  Added after the transformation so that scanners can identify
                  the bundled version from unmodified Maven metadata.
                -->
                <id>jakarta-unpack-fileupload-metadata</id>
                <phase>prepare-package</phase>
                <goals><goal>unpack</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>commons-fileupload</groupId>
                      <artifactId>commons-fileupload</artifactId>
                      <overWrite>true</overWrite>
                      <outputDirectory>${jakarta.classes}</outputDirectory>
                      <includes>META-INF/maven/**</includes>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
              <execution>
                <id>jakarta-copy-test-api</id>
                <phase>process-test-classes</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <skip>${maven.test.skip}</skip>
                  <stripVersion>true</stripVersion>
                  <artifactItems>
                    <!-- Oldest supported (Jakarta EE 9), tested runtime (Jakarta EE 10), newest (Jakarta EE 11). -->
                    <artifactItem>
                      <groupId>jakarta.servlet</groupId>
                      <artifactId>jakarta.servlet-api</artifactId>
                      <version>5.0.0</version>
                      <outputDirectory>${jakarta.test-api}/5.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.servlet.jsp</groupId>
                      <artifactId>jakarta.servlet.jsp-api</artifactId>
                      <version>3.0.0</version>
                      <outputDirectory>${jakarta.test-api}/5.0</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>jakarta.el</groupId>
